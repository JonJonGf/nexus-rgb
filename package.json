{
  "name": "nexus-rgb",
  "version": "0.1.0",
  "private": true,
  "description": "Controle RGB de PCs Windows, gratuito, aberto e local",
  "license": "MIT",
  "engines": {
    "node": ">=24.20.0"
  },
  "scripts": {
    "start": "node server/index.js",
    "test": "node --test --test-concurrency=2 tests/*.test.js",
    "build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build.ps1",
    "test:ui": "playwright test",
    "test:installer": "node scripts/test-installer-smoke.js",
    "test:supervisor": "node scripts/test-supervisor.js",
    "test:stability": "node scripts/test-stability.js",
    "test:offline": "node scripts/test-offline-firewall.js"
  },
  "dependencies": {
    "@napi-rs/canvas": "1.0.11",
    "openrgb-sdk": "0.6.0",
    "qrcode": "1.5.4",
    "quickjs-emscripten": "0.32.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0"
  }
}
